:root {
}

.main-color {
    background-color: rgb(0, 0, 0);
}

.font {
    color: rgb(166, 166, 166);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Pixelta.ttf?fileID=12800000&guid=ea0b1faef086a6c479778b282f46deca&type=3#Pixelta");
    -unity-text-align: upper-center;
}

.buttons {
    width: 200px;
    background-color: rgba(255, 255, 255, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 33px;
    -unity-font-style: normal;
    align-self: center;
}

.buttons:hover {
    background-color: rgba(65, 65, 65, 0);
    background-image: url("project://database/Assets/PKG_EFFECTS/FreeQuickEffectsVol1/Textures/Flare00.PNG?fileID=2800000&guid=e8bb5606fef74314e9e5e19aec6b527e&type=3#Flare00");
    -unity-background-image-tint-color: rgb(171, 171, 171);
}
.sens-slider {
    width: 260px;
    align-self: center;
    margin-top: 12px;
    font-size: 22px;
    flex-direction: column;
}

.sens-slider .unity-base-slider__tracker {
    background-color: rgb(60, 60, 60);
    height: 4px;
}

.sens-slider .unity-base-slider__dragger {
    background-color: rgb(166, 166, 166);
    border-width: 0;
    width: 14px;
    height: 14px;
}

.sens-slider.unity-base-slider > .unity-base-field__label,
.sens-slider.unity-base-slider:hover > .unity-base-field__label,
.sens-slider.unity-base-slider:focus > .unity-base-field__label,
.sens-slider.unity-base-slider:active > .unity-base-field__label {
    color: rgb(166, 166, 166);
}
.sens-slider.unity-base-slider:focus .unity-base-slider__dragger,
.sens-slider.unity-base-slider:active .unity-base-slider__dragger {
    background-color: rgb(210, 210, 210);
    border-width: 0;
}