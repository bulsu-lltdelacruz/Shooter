<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_UI/HUD.uss?fileID=7433441132597879392&amp;guid=2c09f9e65eaa6924eb68cc0d2dad9cac&amp;type=3#HUD"/>
    <ui:VisualElement style="flex-grow: 1; top: 0; bottom: 0; right: 0; left: 0;">
        <ui:VisualElement style="flex-grow: 1; background-color: rgba(26, 26, 26, 0); position: absolute; bottom: 90px; right: 30px; height: 37px; width: 88px; flex-direction: row;">
            <ui:VisualElement name="blue" class="key" style="flex-grow: 1; background-color: rgb(40, 126, 255); display: flex; visibility: hidden;"/>
            <ui:VisualElement name="red" class="key" style="flex-grow: 1; background-color: rgb(255, 37, 37); visibility: hidden;"/>
            <ui:VisualElement name="yellow" class="key" style="flex-grow: 1; background-color: rgb(255, 228, 25); visibility: hidden;"/>
        </ui:VisualElement>
        <ui:Label text="10/15" name="bullet-count" style="align-self: flex-end; align-content: flex-start; position: absolute; bottom: 1px; right: 0; margin-bottom: 30px; margin-right: 30px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Pixelta.ttf?fileID=12800000&amp;guid=ea0b1faef086a6c479778b282f46deca&amp;type=3#Pixelta&quot;); font-size: 34px; color: rgb(166, 166, 166);"/>
        <ui:VisualElement name="crosshair" style="flex-grow: 1; background-image: url(&quot;project://database/Packages/com.unity.collab-proxy/Editor/Assets/Images/iconadd@2x.png?fileID=2800000&amp;guid=efa87fc6a7693ac48844726c5391e3ab&amp;type=3#iconadd@2x&quot;); -unity-background-scale-mode: scale-to-fit; background-size: 3% 5%; -unity-background-image-tint-color: rgb(0, 255, 193); justify-content: flex-end;">
            <ui:VisualElement style="flex-grow: 0; justify-content: flex-end; width: 335px; height: 230px; bottom: 0; position: absolute; align-content: flex-end; align-items: flex-start;">
                <ui:Label text="0/3" name="spell-count" style="align-self: flex-start; align-content: flex-start; position: absolute; bottom: 0; right: 0; margin-bottom: 30px; margin-right: 30px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Pixelta.ttf?fileID=12800000&amp;guid=ea0b1faef086a6c479778b282f46deca&amp;type=3#Pixelta&quot;); font-size: 34px; color: rgb(168, 99, 10); height: 21px; width: 100px; top: auto; left: 0; justify-content: flex-start; translate: 30px -60px;"/>
                <ui:VisualElement name="VisualElement" class="hp-bar" style="flex-grow: 1; height: 40px; width: 240px; background-color: rgba(0, 25, 63, 0.388); max-height: 40px;">
                    <ui:VisualElement name="hp-bar" class="hp-bar" style="flex-grow: 1; background-color: rgb(156, 0, 0); translate: 5px 5px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
